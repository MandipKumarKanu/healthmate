# RapidOCR Remote API configuration
# In production, ALWAYS use HTTPS. For secure deployments, route OCR requests
# through an application backend proxy / API gateway rather than bundling
# privileged server secrets into client APKs.
# For local development with Android Emulator: http://10.0.2.2:8010
EXPO_PUBLIC_OCR_API_URL=https://ocr.yourdomain.com
EXPO_PUBLIC_OCR_API_KEY=your_client_or_proxy_token_here
