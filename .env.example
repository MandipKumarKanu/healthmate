# HealthMate Environment Configuration

# ------------------------------------------------------------------------------
# 1. RapidOCR Remote API Configuration
# ------------------------------------------------------------------------------
# Endpoint URL for the medication packaging OCR analysis service.
# For local development with Android Emulator: http://10.0.2.2:8010
# In production, use HTTPS and route requests through an authenticated backend proxy.
EXPO_PUBLIC_OCR_API_URL=https://ocr.yourdomain.com

# Client authorization token or API gateway key for the OCR service.
EXPO_PUBLIC_OCR_API_KEY=your_client_or_proxy_token_here

# ------------------------------------------------------------------------------
# 2. Android Production Release Keystore (CI/CD & Local Signing)
# ------------------------------------------------------------------------------
# Base64-encoded content of your Android release keystore file (.keystore or .jks).
# Generate via: base64 -w 0 your-release-key.keystore (or base64 -b 0 on macOS)
HEALTHMATE_RELEASE_KEYSTORE_BASE64=

# The alias assigned to the signing key pair within the keystore.
HEALTHMATE_RELEASE_KEY_ALIAS=your_release_key_alias

# The password associated with the private key alias.
HEALTHMATE_RELEASE_KEY_PASSWORD=your_key_password

# The master password required to access the keystore file.
HEALTHMATE_RELEASE_STORE_PASSWORD=your_keystore_password
